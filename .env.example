# Local dev uses SQLite by default. Point at Postgres for production:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/tayseer
DATABASE_URL=sqlite:///./tayseer.db

# REQUIRED in production. Signs session cookies; rotating it logs everyone out.
SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 once you are serving over HTTPS.
SECURE_COOKIES=0
DEBUG=1

# Email. Leave SMTP_HOST unset to log messages to the console instead of sending.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Tayseer <noreply@yourdomain.com>
